      "Bash(git stash drop*)",
      "Bash(git stash clear*)",
      "Bash(git tag -d *)",
      "Bash(git tag --delete *)",
      "Bash(git tag -f *)",
      "Bash(git tag --force *)",
      "Bash(git clean *)",
      "Bash(git reset --hard)",
      "Bash(git rebase *)",
      "Bash(git filter-branch *)",
      "Bash(gh pr merge *)",
      "Bash(gh api *)",
      "PowerShell(git commit *)",
