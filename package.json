{
  "name": "vscode-harness-navigator",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "0.0.1",
  "publisher": "ai-development-harness",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/ai-development-harness/vscode-harness-navigator.git"
  },
  "engines": {
    "vscode": "^1.85.0",
    "node": ">=20.0.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "harnessNavigator",
          "title": "%viewsContainer.harnessNavigator.title%",
          "icon": "$(list-tree)"
        }
      ]
    },
    "views": {
      "harnessNavigator": [
        {
          "id": "harnessNavigator.artifacts",
          "name": "%view.artifacts.name%"
        },
        {
          "id": "harnessNavigator.focus",
          "name": "%view.focus.name%"
        }
      ]
    },
    "commands": [
      {
        "command": "harnessNavigator.showDiagnostics",
        "title": "%command.showDiagnostics.title%"
      },
      {
        "command": "harnessNavigator.refresh",
        "title": "%command.refresh.title%"
      },
      {
        "command": "harnessNavigator.goToArtifact",
        "title": "%command.goToArtifact.title%"
      },
      {
        "command": "harnessNavigator.setSortOrder",
        "title": "%command.setSortOrder.title%",
        "icon": "$(sort-precedence)"
      },
      {
        "command": "harnessNavigator.setFilter",
        "title": "%command.setFilter.title%",
        "icon": "$(filter)"
      },
      {
        "command": "harnessNavigator.clearFilters",
        "title": "%command.clearFilters.title%",
        "icon": "$(clear-all)"
      },
      {
        "command": "harnessNavigator.copyArtifactId",
        "title": "%command.copyArtifactId.title%"
      },
      {
        "command": "harnessNavigator.copyArtifactPath",
        "title": "%command.copyArtifactPath.title%"
      },
      {
        "command": "harnessNavigator.findAllReferences",
        "title": "%command.findAllReferences.title%"
      },
      {
        "command": "harnessNavigator.showRelations",
        "title": "%command.showRelations.title%"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "harnessNavigator.setSortOrder",
          "when": "view == harnessNavigator.artifacts",
          "group": "navigation@1"
        },
        {
          "command": "harnessNavigator.setFilter",
          "when": "view == harnessNavigator.artifacts",
          "group": "navigation@2"
        },
        {
          "command": "harnessNavigator.clearFilters",
          "when": "view == harnessNavigator.artifacts",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "harnessNavigator.copyArtifactId",
          "when": "view == harnessNavigator.artifacts && viewItem == harnessArtifactItem || view == harnessNavigator.focus && viewItem == harnessArtifactItem"
        },
        {
          "command": "harnessNavigator.copyArtifactPath",
          "when": "view == harnessNavigator.artifacts && viewItem == harnessArtifactItem || view == harnessNavigator.focus && viewItem == harnessArtifactItem"
        },
        {
          "command": "harnessNavigator.findAllReferences",
          "when": "view == harnessNavigator.artifacts && viewItem == harnessArtifactItem || view == harnessNavigator.focus && viewItem == harnessArtifactItem",
          "group": "navigation@1"
        },
        {
          "command": "harnessNavigator.showRelations",
          "when": "view == harnessNavigator.artifacts && viewItem == harnessArtifactItem || view == harnessNavigator.focus && viewItem == harnessArtifactItem",
          "group": "navigation@2"
        }
      ],
      "commandPalette": [
        {
          "command": "harnessNavigator.goToArtifact",
          "when": "true"
        },
        {
          "command": "harnessNavigator.setSortOrder",
          "when": "true"
        },
        {
          "command": "harnessNavigator.setFilter",
          "when": "true"
        },
        {
          "command": "harnessNavigator.clearFilters",
          "when": "true"
        },
        {
          "command": "harnessNavigator.copyArtifactId",
          "when": "false"
        },
        {
          "command": "harnessNavigator.copyArtifactPath",
          "when": "false"
        },
        {
          "command": "harnessNavigator.findAllReferences",
          "when": "editorLangId == markdown"
        },
        {
          "command": "harnessNavigator.showRelations",
          "when": "editorLangId == markdown"
        }
      ],
      "editor/context": [
        {
          "command": "harnessNavigator.findAllReferences",
          "when": "resourceLangId == markdown",
          "group": "navigation@10"
        },
        {
          "command": "harnessNavigator.showRelations",
          "when": "resourceLangId == markdown",
          "group": "navigation@11"
        }
      ]
    },
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "harnessNavigator.artifacts.sortOrder": {
          "type": "string",
          "enum": [
            "id",
            "title",
            "status",
            "priority"
          ],
          "default": "id",
          "scope": "window",
          "description": "%configuration.sortOrder.description%"
        },
        "harnessNavigator.artifacts.filter.status": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "planned",
            "in_progress",
            "blocked",
            "completed",
            "deferred",
            "cancelled",
            null
          ],
          "default": null,
          "scope": "window",
          "description": "%configuration.filterStatus.description%"
        },
        "harnessNavigator.artifacts.filter.type": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "implementation",
            "bugfix",
            "refactor",
            "research",
            "adr",
            "audit",
            "review",
            "hardening",
            "documentation",
            "release",
            null
          ],
          "default": null,
          "scope": "window",
          "description": "%configuration.filterType.description%"
        },
        "harnessNavigator.artifacts.filter.priority": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "critical",
            "high",
            "medium",
            "low",
            null
          ],
          "default": null,
          "scope": "window",
          "description": "%configuration.filterPriority.description%"
        },
        "harnessNavigator.artifacts.filter.phase": {
          "type": [
            "string",
            "null"
          ],
          "default": null,
          "scope": "window",
          "description": "%configuration.filterPhase.description%"
        }
      }
    },
    "semanticTokenTypes": [
      {
        "id": "harnessArtifactId",
        "superType": "variable",
        "description": "%semanticToken.harnessArtifactId.description%"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "markdown",
        "scopes": {
          "harnessArtifactId": [
            "constant.other.reference"
          ]
        }
      }
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.unit.json && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint src tests esbuild.js eslint.config.mjs .vscode-test.mjs",
    "format": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"l10n/**/*.json\" \"package.nls*.json\" \"*.{js,mjs,json}\"",
    "format:fix": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"l10n/**/*.json\" \"package.nls*.json\" \"*.{js,mjs,json}\"",
    "clean": "rm -rf dist out",
    "build": "yarn clean && node esbuild.js --production",
    "build:dev": "yarn clean && node esbuild.js",
    "compile:tests": "tsc -p tsconfig.test.json",
    "test:unit": "node --import tsx --test \"tests/unit/**/*.test.ts\"",
    "test:integration": "yarn build:dev && yarn compile:tests && vscode-test",
    "test": "yarn test:unit && yarn test:integration",
    "vscode:prepublish": "yarn build",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/js-yaml": "^4.0.9",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.13.6",
    "@types/vscode": "^1.85.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.8",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0"
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  },
  "packageManager": "yarn@4.10.3+sha512.c38cafb5c7bb273f3926d04e55e1d8c9dfa7d9c3ea1f36a4868fa028b9e5f72298f0b7f401ad5eb921749eb012eb1c3bb74bf7503df3ee43fd600d14a018266f"
}
